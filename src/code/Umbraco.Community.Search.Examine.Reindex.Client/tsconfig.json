{
  "compilerOptions": {
    "target": "es2023",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "esnext",
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client", "@umbraco-cms/backoffice/extension-types"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    "paths": {
      "@umbraco-cms/search/settings": [
        "../../Umbraco.Cms.Search.Core.Client/Client/src/settings/index.ts"
      ],
      "@umbraco-cms/search/global": [
        "../../Umbraco.Cms.Search.Core.Client/Client/src/global/index.ts"
      ]
    }
  },
  "include": ["src"]
}
